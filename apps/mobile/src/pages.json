{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^U(.*)": "@/components/U$1/index.vue",
      "^u-(.*)": "@/components/U$1/index.vue"
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "商城",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index"
      },
      {
        "name": "登录",
        "path": "pages/login/index"
      }
    ]
  },
  "pages": [
    // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
    {
      "path": "pages/index/index",
      "type": "home",
      "style": {
        "navigationBarTitleText": "Mall商城",
        "enablePullDownRefresh": true,
        "app-plus": {
          "titleNView": {
            "type": "transparent",
            "searchInput": {
              "backgroundColor": "rgba(231, 231, 231,.7)",
              "borderRadius": "16px",
              "placeholder": "请输入商品 如：手机",
              "disabled": true,
              "placeholderColor": "#606266"
            },
            "buttons": [
              {
                "fontSrc": "/static/fonts/yticon.ttf",
                "text": "",
                "fontSize": "26",
                "color": "#303133",
                "float": "left",
                "background": "rgba(0,0,0,0)"
              },
              {
                "fontSrc": "/static/fonts/yticon.ttf",
                "text": "",
                "fontSize": "27",
                "color": "#303133",
                "background": "rgba(0,0,0,0)",
                "redDot": true
              }
            ]
          }
        }
      }
    },
    {
      "path": "pages/cart/cart",
      "type": "page",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/category/category",
      "type": "page",
      "style": {
        "navigationBarTitleText": "分类",
        "app-plus": {
          "bounce": "none"
        }
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "",
        "navigationStyle": "custom",
        "app-plus": {
          "titleNView": false,
          "animationType": "slide-in-bottom"
        }
      }
    },
    {
      "path": "pages/mine/mine",
      "type": "page",
      "style": {
        "navigationBarTitleText": "我的",
        "app-plus": {
          "bounce": "none",
          "titleNView": {
            "type": "transparent",
            "buttons": [
              {
                "fontSrc": "/static/fonts/yticon.ttf",
                "text": "",
                "fontSize": "24",
                "color": "#303133",
                "width": "46px",
                "background": "rgba(0,0,0,0)"
              },
              {
                "fontSrc": "/static/fonts/yticon.ttf",
                "text": "",
                "fontSize": "28",
                "color": "#303133",
                "background": "rgba(0,0,0,0)",
                "redDot": true
              }
            ]
          }
        }
      }
    },
    {
      "path": "pages/register/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "",
        "navigationStyle": "custom",
        "app-plus": {
          "titleNView": false,
          "animationType": "slide-in-bottom"
        }
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub/order",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
        {
          "path": "create-order",
          "type": "page",
          "style": {
            "navigationBarTitleText": "确认订单"
          }
        },
        {
          "path": "order-detail",
          "type": "page",
          "style": {
            "navigationBarTitleText": "订单详情"
          }
        },
        {
          "path": "order",
          "type": "page",
          "style": {
            "navigationBarTitleText": "我的订单",
            "app-plus": {
              "bounce": "none"
            }
          }
        },
        {
          "path": "pay-success",
          "type": "page",
          "style": {
            "navigationBarTitleText": "支付成功"
          }
        },
        {
          "path": "pay",
          "type": "page",
          "style": {
            "navigationBarTitleText": "支付"
          }
        }
      ]
    },
    {
      "root": "pages-sub/user",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
        {
          "path": "brand-attention",
          "type": "page",
          "style": {
            "navigationBarTitleText": "品牌关注"
          }
        },
        {
          "path": "product-collection",
          "type": "page",
          "style": {
            "navigationBarTitleText": "商品收藏"
          }
        },
        {
          "path": "read-history",
          "type": "page",
          "style": {
            "navigationBarTitleText": "浏览记录"
          }
        },
        {
          "path": "set",
          "type": "page",
          "style": {
            "navigationBarTitleText": "设置"
          }
        },
        {
          "path": "user-info",
          "type": "page",
          "style": {
            "navigationBarTitleText": "个人信息"
          }
        }
      ]
    },
    {
      "root": "pages-sub/product",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
        {
          "path": "hot-product-list",
          "type": "page",
          "style": {
            "navigationBarTitleText": "热门商品"
          }
        },
        {
          "path": "list",
          "type": "page",
          "style": {
            "navigationBarTitleText": "商品列表",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "new-product-list",
          "type": "page",
          "style": {
            "navigationBarTitleText": "新品推荐"
          }
        },
        {
          "path": "product",
          "type": "page",
          "style": {
            "navigationBarTitleText": "详情展示",
            "app-plus": {
              "titleNView": {
                "type": "transparent"
              }
            }
          }
        }
      ]
    }
  ],
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "borderStyle": "@tabBorderStyle",
    "backgroundColor": "@tabBgColor",
    "list": [
      // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
      {
        "text": "首页",
        "pagePath": "pages/index/index",
        "iconPath": "@iconHome",
        "selectedIconPath": "@iconHomeActive"
      },
      {
        "text": "分类",
        "pagePath": "pages/category/category",
        "iconPath": "@iconCategory",
        "selectedIconPath": "@iconCategoryActive"
      },
      {
        "text": "购物车",
        "pagePath": "pages/cart/cart",
        "iconPath": "@iconCart",
        "selectedIconPath": "@iconCartActive"
      },
      {
        "text": "我的",
        "pagePath": "pages/mine/mine",
        "iconPath": "@iconMine",
        "selectedIconPath": "@iconMineActive"
      }
    ]
  }
}
